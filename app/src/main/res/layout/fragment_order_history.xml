<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"

    android:padding="10dp"
    tools:context=".OrdersHistoryFragment">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvStallNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  S1"
                android:fontFamily="@font/poppins_bold"
                android:textSize="15sp"
                android:layout_marginLeft="18dp"
                android:textStyle="bold"
                android:textColor="@color/green"
                android:background="@drawable/circle_background"
                android:padding="8dp" />

            <ImageView
                android:id="@+id/tvLogo"
                android:layout_width="67dp"
                android:layout_height="57dp"
                android:src="@drawable/loginbg"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginStart="18dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOpen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Open"
                android:textAllCaps="false"
                android:background="@drawable/rounded_button"
                android:textColor="@color/yellow"
                android:padding="1dp"
                android:textSize="12sp"
                android:layout_marginStart="140dp"/>
        </LinearLayout>

        <!-- Tabs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tvOrders"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text=" ORDERS HISTORY"
                android:fontFamily="@font/poppins_bold"
                android:textSize="20sp"
                android:textColor="@color/green"
                android:layout_marginLeft="10dp"
                android:gravity="left"
                />

            <ImageButton
                android:id="@+id/printer"
                android:layout_width="50dp"
                android:layout_height="40dp"
                android:layout_marginEnd="34dp"
                android:background="@drawable/print"
                android:fontFamily="@font/poppins_bold"
                android:gravity="right"
                android:padding="10dp"
                android:src="@drawable/print"
                android:text="Download"
                android:textColor="@color/green"
                app:srcCompat="@drawable/print"
                app:tint="#00FF8B00"
                tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />
        </LinearLayout>



        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingBottom="15dp">

                <ImageButton
                    android:id="@+id/button"
                    android:layout_width="110dp"
                    android:layout_height="50dp"
                    android:backgroundTint="#00FFFFFF"
                    android:src="@drawable/today"
                    android:text=""
                    app:srcCompat="@drawable/today"
                    tools:ignore="SpeakableTextPresentCheck" />

                <ImageButton
                    android:id="@+id/button1"
                    android:layout_width="110dp"
                    android:layout_height="50dp"
                    android:backgroundTint="#00FFFFFF"
                    android:src="@drawable/yesterday"
                    android:text=""
                    app:srcCompat="@drawable/yesterday"
                    tools:ignore="SpeakableTextPresentCheck" />

                <ImageButton
                    android:id="@+id/button2"
                    android:layout_width="110dp"
                    android:layout_height="50dp"
                    android:backgroundTint="#00FFFFFF"
                    android:src="@drawable/last7days"
                    android:text=""
                    app:srcCompat="@drawable/last7days"
                    tools:ignore="SpeakableTextPresentCheck" />

                <ImageButton
                    android:id="@+id/button3"
                    android:layout_width="110dp"
                    android:layout_height="50dp"
                    android:backgroundTint="#00FFFFFF"
                    android:src="@drawable/lastmonth"
                    android:text=""
                    app:srcCompat="@drawable/lastmonth"
                    tools:ignore="SpeakableTextPresentCheck" />

            </LinearLayout>

        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/rounded_border"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="1dp">

                <ScrollView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">



                </ScrollView>
        </LinearLayout>

</LinearLayout>