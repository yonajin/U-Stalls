<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="10dp"
    tools:context=".OrdersHistoryFragment">
    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvStallNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="  S1"
            android:fontFamily="@font/poppins_bold"
            android:textSize="15sp"
            android:layout_marginLeft="18dp"
            android:textStyle="bold"
            android:textColor="@color/green"
            android:background="@drawable/circle_background"
            android:padding="8dp" />

        <ImageView
            android:id="@+id/tvLogo"
            android:layout_width="67dp"
            android:layout_height="57dp"
            android:src="@drawable/loginbg"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="18dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnOpen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open"
            android:textAllCaps="false"
            android:background="@drawable/rounded_button"
            android:textColor="@color/yellow"
            android:padding="1dp"
            android:textSize="12sp"
            android:layout_marginStart="140dp"/>
    </LinearLayout>

    <!-- Tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/left_arrow"
            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:backgroundTint="#00FFFFFF"
            android:src="@drawable/left_arrow"
            android:text=""
            app:srcCompat="@drawable/left_arrow" />

        <TextView
            android:id="@+id/tvOrders"
            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="ORDERS HISTORY"
            android:fontFamily="@font/poppins_bold"
            android:textSize="20sp"
            android:textColor="@color/green"
            />

        <ImageButton
            android:id="@+id/printer"
            android:layout_width="50dp"
            android:layout_height="40dp"
            android:text=""
            app:tint="#00FF8B00"
            android:src="@drawable/print"
            app:srcCompat="@drawable/print"
            android:background="@drawable/print"
            android:layout_marginEnd="34dp"
            android:fontFamily="@font/poppins_bold"
            android:textColor="@color/green"
            android:gravity="right"
            android:padding="10dp"/>
    </LinearLayout>



    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:orientation="horizontal"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingBottom="50dp">

            <Button
                android:id="@+id/button"
                android:layout_width="100dp"
                android:layout_height="40dp"
                android:layout_marginRight="5dp"
                android:backgroundTint="#A48F15"
                android:fontFamily="@font/poppins_regular"
                android:text="Today"
                android:textSize="14sp" />

            <Button
                android:id="@+id/button1"
                android:layout_width="120dp"
                android:layout_height="40dp"
                android:layout_marginRight="5dp"
                android:backgroundTint="#00FFFFFF"
                android:fontFamily="@font/poppins_regular"
                android:text="Yesterday"
                android:textColor="#000000"
                android:textColorLink="#01FFFFFF"
                android:textSize="14sp"
                app:cornerRadius="20dp"
                app:strokeWidth="1dp"
                app:strokeColor="#000000" />

            <Button
                android:id="@+id/button2"
                android:layout_width="130dp"
                android:layout_height="40dp"
                android:layout_marginRight="5dp"
                android:backgroundTint="#00FFFFFF"
                android:fontFamily="@font/poppins_regular"
                android:text="Last 7 Days"
                android:textColor="#000000"
                android:textColorLink="#01FFFFFF"
                android:textSize="14sp"
                app:cornerRadius="20dp"
                app:strokeWidth="1dp"
                app:strokeColor="#000000" />

            <Button
                android:id="@+id/button3"
                android:layout_width="130dp"
                android:layout_height="40dp"
                android:backgroundTint="#00FFFFFF"
                android:fontFamily="@font/poppins_regular"
                android:text="Last Month"
                android:textColor="#000000"
                android:textColorLink="#01FFFFFF"
                android:textSize="14sp"
                app:cornerRadius="20dp"
                app:strokeWidth="1dp"
                app:strokeColor="#000000" />

        </LinearLayout>

    </HorizontalScrollView>


    <!-- Order Status Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/rounded_border"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="1dp">


        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                >

                <androidx.cardview.widget.CardView
                    android:layout_width="340dp"
                    android:layout_height="90dp"
                    android:layout_marginTop="30dp"
                    android:layout_marginBottom="20dp"
                    android:orientation="vertical"
                    app:cardCornerRadius="16dp">

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/rectanglecard"
                        >

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="20dp"
                            android:layout_marginTop="15dp"
                            android:fontFamily="@font/poppins_bold"
                            android:text="03-2324-037820"
                            android:textColor="@color/yellow"
                            android:textSize="12sp"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:text="Vlad Neri"
                            android:layout_marginLeft="20dp"
                            android:textColor="@color/black"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins"
                            android:text="Today 12:40"
                            android:layout_marginLeft="20dp"
                            android:layout_marginTop="5dp"
                            android:textColor="@color/black"
                            android:textSize="12sp" />


                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="340dp"
                    android:layout_height="90dp"
                    android:layout_marginBottom="20dp"
                    android:orientation="vertical"
                    app:cardCornerRadius="16dp">

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/rectanglecard"
                        >

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="20dp"
                            android:layout_marginTop="15dp"
                            android:fontFamily="@font/poppins_bold"
                            android:text="03-2324-037820"
                            android:textColor="@color/yellow"
                            android:textSize="12sp"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:text="Vlad Neri"
                            android:layout_marginLeft="20dp"
                            android:textColor="@color/black"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins"
                            android:text="Today 12:50"
                            android:layout_marginLeft="20dp"
                            android:layout_marginTop="5dp"
                            android:textColor="@color/black"
                            android:textSize="12sp" />


                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="340dp"
                    android:layout_height="90dp"
                    android:layout_marginBottom="20dp"
                    android:orientation="vertical"
                    app:cardCornerRadius="16dp">

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/rectanglecard"
                        >

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="20dp"
                            android:layout_marginTop="15dp"
                            android:fontFamily="@font/poppins_bold"
                            android:text="03-2324-037820"
                            android:textColor="@color/yellow"
                            android:textSize="12sp"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:text="Vlad Neri"
                            android:layout_marginLeft="20dp"
                            android:textColor="@color/black"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins"
                            android:text="Today 10:00"
                            android:layout_marginLeft="20dp"
                            android:layout_marginTop="5dp"
                            android:textColor="@color/black"
                            android:textSize="12sp" />


                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="340dp"
                    android:layout_height="90dp"
                    android:layout_marginBottom="20dp"
                    android:orientation="vertical"
                    app:cardCornerRadius="16dp">

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/rectanglecard"
                        >

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="20dp"
                            android:layout_marginTop="15dp"
                            android:fontFamily="@font/poppins_bold"
                            android:text="03-2324-037820"
                            android:textColor="@color/yellow"
                            android:textSize="12sp"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:text="Vlad Neri"
                            android:layout_marginLeft="20dp"
                            android:textColor="@color/black"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins"
                            android:text="Today 10:10"
                            android:layout_marginLeft="20dp"
                            android:layout_marginTop="5dp"
                            android:textColor="@color/black"
                            android:textSize="12sp" />


                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="340dp"
                    android:layout_height="90dp"
                    android:layout_marginBottom="20dp"
                    android:orientation="vertical"
                    app:cardCornerRadius="16dp">

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/rectanglecard"
                        >

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="20dp"
                            android:layout_marginTop="15dp"
                            android:fontFamily="@font/poppins_bold"
                            android:text="03-2324-037820"
                            android:textColor="@color/yellow"
                            android:textSize="12sp"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:text="Vlad Neri"
                            android:layout_marginLeft="20dp"
                            android:textColor="@color/black"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins"
                            android:text="Today 10:15"
                            android:layout_marginLeft="20dp"
                            android:layout_marginTop="5dp"
                            android:textColor="@color/black"
                            android:textSize="12sp" />


                    </LinearLayout>

                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@color/white"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled"
        app:itemIconSize="50dp"
        app:itemIconTint="@color/yellow"
        app:itemTextColor="@color/black"/>
</LinearLayout>
